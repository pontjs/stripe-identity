{
  "name": "@pontx/stripe-identity",
  "version": "0.1.2",
  "packageManager": "pnpm@10.22.0",
  "description": "Type-safe Stripe Identity API SDK and privacy-first CLI generated from Stripe's official OpenAPI contract",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup && pontx cli build",
    "contract:verify": "node scripts/verify-contract.mjs",
    "dev": "tsup --watch",
    "pontx": "pontx generate",
    "generate:check": "node scripts/verify-generated.mjs",
    "release:verify": "node scripts/verify-release-readiness.mjs && pnpm quality",
    "type-check": "tsc --noEmit",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:e2e": "node --test test/e2e/*.test.mjs",
    "test:types": "tsc --project test/types/tsconfig.json",
    "quality": "pnpm contract:verify && pnpm generate:check && pnpm type-check && pnpm test:unit && pnpm build && pnpm test:types && pnpm test:e2e",
    "prepublishOnly": "pnpm release:verify"
  },
  "keywords": [
    "stripe",
    "stripe-identity",
    "identity-verification",
    "openapi",
    "api",
    "sdk",
    "typescript"
  ],
  "author": "Pontx Contributors",
  "license": "MIT",
  "homepage": "https://pontx.dev/en/sdks/stripe-identity",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pontjs/stripe-identity.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@pontx/sdk": "1.0.0-beta.5",
    "pontx": "1.0.0-beta.12"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pontx": {
    "specDir": "dist/bin"
  },
  "bin": {
    "pontx-stripe-identity": "./dist/bin/cli.cjs"
  }
}
